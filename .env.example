# Required: OpenAI API key used by LangChain/OpenAI calls.
OPENAI_API_KEY=replace-me

# Required for the Telegram polling bot. Do not commit your real token.
TELEGRAM_BOT_TOKEN=replace-me

# Access mode. Use "open" for public access or "invite" to require one-time keys.
BOT_ACCESS_MODE=open

# Required only when BOT_ACCESS_MODE=invite or when creating access keys.
# Generate with: python - <<'PY'
# import secrets; print(secrets.token_urlsafe(32))
# PY
BOT_AUTH_SECRET=

# Optional: USDA FoodData Central key. If omitted, the app uses the local fallback table.
USDA_API_KEY=

# Optional: FatSecret Platform API OAuth2 client credentials. If omitted, FatSecret is disabled.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Optional provider toggles. Missing credentials disable only that provider.
ENABLE_USDA=true
ENABLE_FATSECRET=true
ENABLE_OPEN_FOOD_FACTS=true

# Optional model configuration. Override these if your account uses different model names.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_ESCALATION_MODEL=gpt-5.4-mini
OPENAI_VISION_ESCALATION_CONFIDENCE=low
OPENAI_CRITIC_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
# Cooperative request budget; no new external call begins after it expires.
REQUEST_DEADLINE_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_SCOPE_MAX_OUTPUT_TOKENS=512
OPENAI_CRITIC_MAX_OUTPUT_TOKENS=512
OPENAI_VISION_MAX_OUTPUT_TOKENS=2048
# Luna text/scope calls explicitly use none unless overridden. Do not set a
# global reasoning override while GPT-4.1 vision/critic models are configured.
# OPENAI_REASONING_EFFORT=none
# Task-specific override, leaving scope/vision/critic reasoning settings untouched.
# OPENAI_TEXT_REASONING_EFFORT=none
CRITIC_MAX_ITERATIONS=2
QUALITATIVE_CRITIC_ENABLED=true

# Optional moderation toggle. When disabled or unavailable, conservative local checks still run.
OPENAI_MODERATION_ENABLED=true

# Optional local paths.
NUTRITION_CACHE_DIR=.cache/nutrition-agent
NUTRITION_RETRIEVAL_MAX_WORKERS=3
USDA_DETAIL_LIMIT=3
NUTRITION_DIAGNOSTICS_INCLUDE_RAW=false
NUTRITION_DIAGNOSTICS_MAX_PAYLOAD_CHARS=2000
FOOD_LINKER_EMBEDDINGS_ENABLED=false
FOOD_LINKER_SHADOW_ENABLED=false
FOOD_LINKER_SIMILARITY_THRESHOLD=0.62
TEMP_IMAGE_DIR=/tmp/nutrition-agent-images
MAX_IMAGE_BYTES=10000000
AUTH_DB_PATH=data/auth.sqlite3
USAGE_DB_PATH=
BOT_CONCURRENT_UPDATES=8
BOT_PER_USER_IN_FLIGHT_LIMIT=1
BOT_DAILY_USER_REQUEST_LIMIT=100
BOT_DAILY_GLOBAL_REQUEST_LIMIT=1000
BOT_USER_BURST_REQUEST_LIMIT_PER_MINUTE=6
BOT_DAILY_USER_PHOTO_LIMIT=25
BOT_GLOBAL_USAGE_WARNING_RATIO=0.8
BOT_ADMIN_CHAT_ID=
MEMORY_DB_PATH=
MEMORY_RECENT_MESSAGES=10
MEMORY_SUMMARIZE_AFTER_MESSAGES=16
MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_RETENTION_DAYS=0
USAGE_COUNTER_RETENTION_DAYS=7

# Optional localhost HTTP liveness probe. Disabled by default.
HEALTH_HTTP_ENABLED=false
HEALTH_HTTP_HOST=127.0.0.1
HEALTH_HTTP_PORT=8080

# Optional Phoenix tracing. Disabled by default.
# Start the self-hosted Phoenix collector first, then set ENABLE_PHOENIX_TRACING=true.
ENABLE_PHOENIX_TRACING=false
PHOENIX_PROJECT_NAME=nutrition-agent
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
